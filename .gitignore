# pixi environments
.pixi/*
!.pixi/config.toml

# Build artifacts
target/
*.wasm

# OS files
**.DS_Store

# Generated outputs (prevent future artifact accumulation)
**.ply
**.svg
**.csv
**.png
**.jpg
**.JPG

# Documentation figures are source, embedded in rustdoc from `crates/<crate>/figures/`.
!crates/*/figures/*.svg
# The README's hero image.
!docs/images/hero.jpg

# Python caches
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Reports
reports/

# Local virtualenvs (created in-project)
.venv/

# IDE
.idea/
.vscode/
*.swp
*.swo
.claude/worktrees/

# Python bindings: notices generated by `pixi run -e python py-notices`, and the native module
# that `maturin develop` places next to the package sources.
bindings/python/THIRD_PARTY_LICENSES.txt
bindings/python/python/openmvg_rs/_native.*.so
bindings/python/python/openmvg_rs/_native.*.pyd
# The wheel and sdist that a local maturin build writes.
bindings/python/dist/
